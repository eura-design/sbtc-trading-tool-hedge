# Dependencies
backend/node_modules/
frontend/node_modules/

# Build output
frontend/dist/

# Environment variables (API keys)
backend/.env

# Logs — backend/logs/<날짜>.jsonl (구조화 이벤트 + 콘솔, 30일 보존)
backend/logs/
backend/pending_orders.json
backend/indicator_params.json

# 월별 수익 결산 데이터 (실제 잔고·손익이라 저장소에 남기지 않는다)
기타/tracker_data.json

# Screenshots (자동 캡처된 진입/청산 PNG)
ScreenShot/

# Git backup folder (히스토리 리셋 시 안전용)
.git.bak/

# Python cache
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
